# Salin ke .env, lalu isi semua nilai. Jangan commit .env.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Buat dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

ADMIN_USER=admin

# Buat dengan: npm run set-password
# Perintah itu menulis hash ke .env dan menampilkan password sekali.
ADMIN_PASSWORD_HASH=

PORT=3000
SHORTLINK_BASE_URL=https://vriz.my.id
SMARTLINK_URL=https://ardance.org/4/ab922a0e2ab02af3c547ceb6c4e4c54f
SAFELINK_WAIT_SECONDS=20
SAFELINK_FINAL_SECONDS=10
